# ---------- Java artifacts ----------
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Keep the Maven wrapper (needed to build without a global Maven)
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar

# ---------- Spring Boot / app config ----------
# Local-only overrides; commit application.yml itself, not these
application-local.yml
application-local.yaml
application-local.properties
application-secret*.yml
application-secret*.properties

# ---------- Secrets and environment ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# ---------- Docker ----------
# Only matters if you use host bind mounts for database data
pgdata/
*-data/
docker-compose.override.yml

# ---------- Logs and temp ----------
*.log
logs/
*.tmp
*.swp
*.swo
*~

